# Copy this file to .env and fill in your own values.
# Nothing here has a real default: this project ships with no credentials,
# tokens, or chat ids baked in.

# --- Watchlist: which tickers to cover each morning ---
# Comma-separated Yahoo Finance symbols, e.g. AAPL,MSFT,NVDA.
WATCHLIST_TICKERS=
# Optional: path to a file with one ticker per line (blank lines and lines
# starting with '#' are ignored). When set, its tickers are merged with
# WATCHLIST_TICKERS (duplicates removed, order preserved).
WATCHLIST_FILE=

# --- Optional ticker -> company display names ---
# Used to label digest sections/summaries with human-friendly names, e.g.
# "AAPL — Apple Inc." instead of just "AAPL". Two formats are accepted:
#   COMPANY_NAMES=AAPL=Apple Inc.,MSFT=Microsoft Corp.,NVDA=NVIDIA Corp.
#   COMPANY_NAMES={"AAPL": "Apple Inc.", "MSFT": "Microsoft Corp."}
# Unlisted tickers fall back to the ticker symbol. Leave empty to disable.
COMPANY_NAMES=

# --- News fetching ---
# Only articles published within this many hours are considered "this
# morning's news".
NEWS_LOOKBACK_HOURS=24
# How many recent articles to pull per ticker before summarizing.
NEWS_PER_TICKER=10
# Best-effort fetch of the full article page text for a better summary.
# Disable to summarize from the headline/snippet only (faster, fewer
# requests, avoids paywalls).
NEWS_FETCH_ARTICLE_TEXT=true
# Cap on the characters of article body sent to the LLM.
NEWS_MAX_ARTICLE_CHARS=6000
# Yahoo Finance endpoints (normally unchanged).
YAHOO_NEWS_BASE_URL=https://query1.finance.yahoo.com
YAHOO_RSS_BASE_URL=https://feeds.finance.yahoo.com/rss/2.0/headline

# --- Summarization LLM (any OpenAI-compatible /v1/chat/completions API,
# e.g. Ocabra) ---
LLM_CHAT_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120

# Optional second backend for the watchlist-wide "overall" summary only, e.g.
# to run the final synthesis on a larger model. Each field falls back to the
# matching LLM_* value above when unset; leave all three blank to reuse the
# main backend.
LLM_OVERALL_CHAT_URL=
LLM_OVERALL_API_KEY=
LLM_OVERALL_MODEL=
# Per-request timeout for the overall backend; 0 means use LLM_TIMEOUT_SECONDS.
LLM_OVERALL_TIMEOUT_SECONDS=0

# Optional tone/style instruction appended to the overall-summary prompt,
# e.g. "brisk and plain-spoken" or "formal wire-service prose". Empty keeps
# the default neutral/factual wording.
DIGEST_TONE=

# --- Telegram delivery of the morning digest ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Built-in morning scheduler ---
# When true, the server generates and delivers the digest every day at
# DIGEST_TIME. Only runs when YF_MCP_TRANSPORT=http (an always-on service);
# a stdio subprocess is spawned per client request and never self-schedules.
DIGEST_SCHEDULER_ENABLED=false
DIGEST_TIME=07:00
DIGEST_TIMEZONE=UTC

# Directory for the persisted digests (latest.md, latest.json, and one
# dated file per run). Empty disables persistence.
DIGEST_STATE_DIR=/data/digests

# --- Fetch/summary caching ---
# Caches fetched article bodies and their LLM summaries (per-article and
# per-company) to disk, keyed by article content, so a repeat
# generate_digest/summarize_ticker call within CACHE_TTL_HOURS reuses them
# instead of re-fetching publisher pages and re-invoking the summarization
# model -- the model call is the expensive, slow part, especially against a
# local/single-request backend. Defaults to DIGEST_STATE_DIR when unset (so
# persistence and caching share the same volume by default); set explicitly
# to use a different location, or leave both empty to disable caching
# entirely (always fetch/summarize fresh, the original behavior).
CACHE_DIR=
CACHE_TTL_HOURS=24

HTTP_TIMEOUT_SECONDS=30

# Console/log verbosity: DEBUG, INFO, WARNING, ERROR, or CRITICAL
# (case-insensitive; falls back to INFO if unset or unrecognized). INFO logs
# every tool call and its outcome, not just failures.
LOG_LEVEL=INFO

# --- MCP server transport (yahoofinance-newsmcp-server) ---
# "http" (default): serve MCP over Streamable HTTP as an always-on service,
# required for the morning scheduler and for a client on a different
# host/container (e.g. ocabra_telegram). Listens on YF_MCP_HTTP_PORT (3654).
# "stdio": a client spawns this process and pipes its stdin/stdout directly --
# for a same-host/CLI-managed install. Set this explicitly to opt in.
YF_MCP_TRANSPORT=http
YF_MCP_HTTP_HOST=0.0.0.0
YF_MCP_HTTP_PORT=3654
YF_MCP_HTTP_PATH=/mcp

# Required in practice whenever YF_MCP_TRANSPORT=http: every request must
# carry a matching `Authorization: Bearer <this>` header, checked with a
# constant-time compare. Leave unset only if the network path here (private
# LAN/VPN/Tailscale only) is trusted on its own. Generate one with e.g.
# `openssl rand -hex 32`.
YF_MCP_AUTH_TOKEN=
