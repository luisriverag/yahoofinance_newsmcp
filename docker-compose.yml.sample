services:
  yahoofinance-newsmcp:
    build: .
    container_name: yahoofinance-newsmcp
    restart: always
    env_file:
      - .env
    ports:
      # Host:container. Change the host side if 8080 is taken, or bind to a
      # specific interface (e.g. "192.168.1.16:8080:8080") to keep this off a
      # public interface -- see README.md's auth note either way.
      - "8080:8080"
    volumes:
      # Persist the generated digests. This must match DIGEST_STATE_DIR in
      # .env (container-side path).
      - ./data:/data
      # If WATCHLIST_FILE is used, mount it in and point the variable at the
      # path INSIDE this container, e.g.:
      # - ./watchlist.txt:/app/watchlist.txt
